        "HOOK_METHOD(Room, SpawnGridEntity, (int idx, unsigned int type, unsigned int variant, unsigned int seed, int vardata) -> bool) {",
        "\tconst int callbackid = 1100;",
        "\tif (!noInfLoop && CallbackState.test(callbackid - 1000)) {",
        "\t\tlua_State* L = g_LuaEngine->_state;",
        "\t\tlua::LuaStackProtector protector(L);",
        "",
        "\t\tlua_rawgeti(L, LUA_REGISTRYINDEX, g_LuaEngine->runCallbackRegistry->key);",
        "",
        "\t\tlua::LuaResults result = lua::LuaCaller(L).push(callbackid)",
        "\t\t\t.push(type)",
        "\t\t\t.push(type)",
        "\t\t\t.push(variant)",
        "\t\t\t.push(vardata)",
        "\t\t\t.push(idx)",
        "\t\t\t.push(seed)",
        "\t\t\t.pushnil() // no GridEntityDesc",
        "\t\t\t.call(1);",
        "",
        "\t\tif (!result) {",
        "\t\t\tif (lua_istable(L, -1)) {",
        "\t\t\t\ttype = (GridEntityType)ProtectedCallbackIntAssign(L, type, 1);",
        "\t\t\t\tvariant = ProtectedCallbackIntAssign(L, variant, 2);",
        "\t\t\t\tvardata = ProtectedCallbackIntAssign(L, vardata, 3);",
        "\t\t\t\tseed = ProtectedCallbackIntAssign(L, seed, 4);",
        "\t\t\t}",
        "\t\t\telse if (lua_isuserdata(L, -1)) {",
        "\t\t\t\tGridEntityDesc* desc = lua::GetLuabridgeUserdata<GridEntityDesc*>(L, -1, lua::Metatables::GRID_ENTITY_DESC, \"GridEntityDesc\");",
        "\t\t\t\tnoInfLoop = true;",
        "\t\t\t\treturn g_Game->_room->SpawnGridEntityDesc(idx, desc);",
        "\t\t\t}",
        "\t\t\telse if (lua_isboolean(L, -1) && !lua_toboolean(L, -1))",
        "\t\t\t{",
        "\t\t\t\treturn false;",
        "\t\t\t}",
        "\t\t}",
        "\t}",
        "\tnoInfLoop = false;",
        "\treturn super(idx, type, variant, seed, vardata);",
        "}",
        ""
      ]

    "unsigned char* FunctionHook_private::EmitPrologue(FunctionDefinition const* def, unsigned char* ptr) {",
    "\tusing namespace HookSystem;",
    "\tptr = Push(EBP, ptr);",
    "\tptr = Mov(EBP, ESP, ptr);",
    "",
    "\t/// Preserve registers",
    "",
    "\t// If the function doesn't return a value, eax must be preserved",
    "\tif (def->IsVoid()) {",
    "\t\tptr = Push(EAX, ptr);",
    "\t}",
    "",
    "\t// If the function needs less than 32 bits to return a value, or if the function doesn't return anything preserve edx",
    "\tif (!def->IsLongLong() || def->IsVoid()) {",
    "\t\tptr = Push(EDX, ptr);",
    "\t}",
    "",
    "\t// Preserve ebx, ecx, edi, esi in all cases",
    "\tptr = Push(EBX, ptr);",
    "\tptr = Push(ECX, ptr);",
    "\tptr = Push(EDI, ptr);",
    "\tptr = Push(ESI, ptr);",
    "",
    "\treturn ptr;",
    "}",
    "",
    "unsigned char* FunctionHook_private::EmitEpilogue(FunctionDefinition const* def, unsigned char stackPos, unsigned char* ptr) {",
    "\tusing namespace HookSystem;",
    "",
    "\tptr = Pop(ESI, ptr);",
    "\tptr = Pop(EDI, ptr);",
    "\tptr = Pop(ECX, ptr);",
    "\tptr = Pop(EBX, ptr);",
    "",
    "\tif (!def->IsLongLong() || def->IsVoid()) {",
    "\t\tptr = Pop(EDX, ptr);",
    "\t}",
    "",
    "\tif (def->IsVoid()) {",
    "\t\tptr = Pop(EAX, ptr);",
    "\t}",
    "",
    "\tptr = Mov(ESP, EBP, ptr);",
    "\tptr = Pop(EBP, ptr);",
    "",
    "\t// If the function is **callee** cleanup, clean the stack",
    "\tif (stackPos > 0 && !def->NeedsCallerCleanup()) {",
    "\t\tptr = Ret(stackPos, ptr);",
    "\t}",
    "\telse {",
    "\t\tptr = Ret(0, ptr);",
    "\t}",
    ""
  ]

+-- status 是帧尾缓存，模拟内回调会落后一轮；witness 只读当前主线程的实际边界。
+-- 缺失接口时保留空 witness，归约不能把旧快照或 Game frame 补成有效证据。
+local function currentWitness()
+    local ok, response = pcall(Isaac.ExecuteCommand, "cs witness")
+    local witness = {}
+    if ok then
+        response = tostring(response)
+        for _, key in ipairs({ "witness_version", "frame", "simulation_tick", "session_generation",
+            "a_generation", "b_generation", "blocks", "owner", "owner_token" }) do
+            witness[key] = tonumber(response:match("\n" .. key .. "=(%d+)"))
+        end
+    end
+    return witness
 end
 

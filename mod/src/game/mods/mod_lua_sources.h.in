namespace cs::game {
// isaaccs_api.lua：联机层的 IsaacCS 实现。
inline constexpr unsigned char kModApiSource[] = {
@ISAACCS_API_BYTES@
};
// isaaccs_dispatch.lua：回调放行、加载与卸载通知、Input 路由、内容 ID 表读取。
inline constexpr unsigned char kModDispatchSource[] = {
@ISAACCS_DISPATCH_BYTES@
};
}

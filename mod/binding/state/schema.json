        },
        "host": {
          "type": "string"
        },
        "client": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "element": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535

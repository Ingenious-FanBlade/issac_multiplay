{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "原生字节归属与二进制状态布局域文件",
  "type": "object",
  "required": [
    "types"
  ],
  "properties": {
    "types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layout"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "integer": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^0x[0-9A-Fa-f]+$"
        }
      ]
    },
    "range": {
      "type": "object",
      "required": [
        "offset",
        "size",
        "category",
        "type",
        "name",
        "semantics",
        "evidence",
        "status"
      ],
      "properties": {
        "offset": {
          "$ref": "#/$defs/integer"
        },
        "size": {
          "$ref": "#/$defs/integer"
        },
        "category": {
          "enum": [
            "状态",
            "换算",
            "引用",
            "资源",
            "容器",
            "本地",
            "派生",
            "权威",
            "填充",
            "未知"
          ]
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "semantics": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "已核",
            "SDK声明",
            "推断",
            "未知"
          ]
        },
        "shape": {
          "type": "boolean"
        },
        "read_requires": {
          "type": "string",
          "minLength": 1
        },
        "wire": {
          "$ref": "#/$defs/wire"
        }
      },
      "additionalProperties": false
    },
    "wire": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "copy",
            "convert",
            "reference",
            "resource",
            "container",
            "nested"
          ]
        },
        "type": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "client": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "element": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4294967294
        },
        "stride": {
          "$ref": "#/$defs/integer"
        },
        "inline_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "storage": {
          "enum": [
            "vector",
            "deque",
            "string",
            "array",
            "shared-owner"
          ]
        },
        "count_field": {
          "type": "string"
        },
        "count_from": {
          "type": "string"
        },
        "projections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          }
        }
      },
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "required": [
        "id",
        "name",
        "sequence",
        "fields"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "enum": [
            "world",
            "body",
            "world-or-player-body"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "reserved": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "required": [
        "id",
        "disposition",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "field",
            "derived",
            "authority",
            "not_applicable"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "count_group": {
      "type": "object",
      "required": ["name", "fields", "limit", "evidence"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "limit": {"type": "integer", "minimum": 1, "maximum": 65535},
        "evidence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "required": [
        "type",
        "native_size",
        "parent",
        "rtti",
        "layout",
        "ranges",
        "blocks",
        "conversions",
        "validators",
        "members",
        "public_owners"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"
        },
        "native_size": {
          "$ref": "#/$defs/integer"
        },
        "sdk_size": {
          "$ref": "#/$defs/integer"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "layout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65534
        },
        "rtti": {
          "type": "object",
          "required": [
            "name",
            "rva"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "rva": {
              "$ref": "#/$defs/integer"
            }
          },
          "additionalProperties": false
        },
        "pure_value": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        },
        "public_owners": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "ranges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/range"
          }
        },
        "blocks": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          }
        },
        "count_groups": {
          "type": "array",
          "items": {"$ref": "#/$defs/count_group"}
        },
        "validators": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "kind",
              "scalar"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "finite",
                  "boolean",
                  "range",
                  "enum"
                ]
              },
              "scalar": {
                "type": "string"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "conversions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "variants": {
          "type": "object",
          "required": [
            "selector",
            "arms"
          ],
          "properties": {
            "selector": {
              "type": "string"
            },
            "arms": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "layout",
                  "values"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "layout": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65534
                  },
                  "values": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "integer"
                    },
                    "uniqueItems": true
                  },
                  "ranges": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/range"
                    }
                  },
                  "blocks": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/block"
                    }
                  },
                  "validators": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "required": [
                        "kind",
                        "scalar"
                      ],
                      "properties": {
                        "kind": {
                          "enum": [
                            "finite",
                            "boolean",
                            "range",
                            "enum"
                          ]
                        },
                        "scalar": {
                          "type": "string"
                        },
                        "min": {
                          "type": "number"
                        },
                        "max": {
                          "type": "number"
                        },
                        "values": {
                          "type": "array",
                          "items": {
                            "type": "integer"
                          },
                          "uniqueItems": true
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "conversions": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "members": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/member"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "contexts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "type",
              "semantics",
              "evidence"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "semantics": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "extent": {
          "enum": [
            "object",
            "base_prefix"
          ]
        },
        "companions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "semantics", "evidence", "status", "host", "client"],
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z_0-9]*$"},
              "type": {"type": "string", "minLength": 1},
              "semantics": {"type": "string", "minLength": 1},
              "evidence": {"type": "string", "minLength": 1},
              "status": {"enum": ["已核", "SDK声明", "推断", "未知"]},
              "host": {"type": "string", "minLength": 1},
              "client": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
